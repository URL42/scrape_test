# Copy to .env and fill in. .env is gitignored - never commit real keys.
#   cp .env.example .env
# A real environment variable always wins over anything set here.

# --- Which brain generates the brief ---------------------------------------
# deepseek (default) | claude
SCRAPE_TEST_LLM=deepseek

# --- DeepSeek (default provider) -------------------------------------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Anthropic (only needed if SCRAPE_TEST_LLM=claude) ----------------------
# ANTHROPIC_API_KEY=

# --- Optional tuning --------------------------------------------------------
# Override the provider's default model.
#   deepseek: deepseek-v4-pro (default) | deepseek-flash (cheaper)
#   claude:   claude-opus-5
# SCRAPE_TEST_MODEL=deepseek-flash

# DeepSeek reasoning effort: low | high (default) | max
# Lower effort means fewer reasoning tokens, which are billed as output.
# SCRAPE_TEST_EFFORT=low

# Max output tokens per brief.
# SCRAPE_TEST_MAX_TOKENS=8000

# Identify yourself to the sites this scrapes. Courteous, not required.
# SCRAPE_TEST_CONTACT=you@example.com

# Where the SQLite cache lives. Defaults to ./data
# SCRAPE_TEST_DATA=/absolute/path/to/data
